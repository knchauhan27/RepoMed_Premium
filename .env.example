# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_MODE=live

# Transactional purchase emails (set these as Supabase Edge Function secrets)
RESEND_API_KEY=re_your_resend_api_key
REPOMED_FROM_EMAIL=noreply@repomed.in
REPOMED_FROM_NAME=RepoMed
REPOMED_BASE_URL=https://repomed.in

# Application Configuration
ALLOWED_ORIGINS=https://repomed.in,https://www.repomed.in,http://localhost:5500,http://127.0.0.1:5500
NODE_ENV=production

# Export Configuration
PDF_EXPORT_MAX_QUESTIONS=500
CSV_EXPORT_MAX_QUESTIONS=500
